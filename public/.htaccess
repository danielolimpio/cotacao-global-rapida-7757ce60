<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Forçar HTTPS (Segurança e SEO)
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Remover trailing slash (evitar conteúdo duplicado)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Redirecionamentos 301 de URLs antigas para novas
# Cambio
RewriteRule ^dolar/?$ /cambio/dolar-hoje [R=301,L]
RewriteRule ^euro/?$ /cambio/euro-hoje [R=301,L]
RewriteRule ^libra/?$ /cambio/libras-esterlinas-hoje [R=301,L]
RewriteRule ^iene/?$ /cambio/iene-hoje [R=301,L]
RewriteRule ^cambio/dolar$ /cambio/dolar-hoje [R=301,L]
RewriteRule ^cambio/euro$ /cambio/euro-hoje [R=301,L]

# Crypto
RewriteRule ^bitcoin/?$ /crypto/bitcoin-hoje [R=301,L]
RewriteRule ^ethereum/?$ /crypto/ethereum-hoje [R=301,L]
RewriteRule ^btc/?$ /crypto/bitcoin-hoje [R=301,L]
RewriteRule ^eth/?$ /crypto/ethereum-hoje [R=301,L]
RewriteRule ^crypto/bitcoin$ /crypto/bitcoin-hoje [R=301,L]
RewriteRule ^crypto/ethereum$ /crypto/ethereum-hoje [R=301,L]

# Ações
RewriteRule ^apple/?$ /acoes/apple-hoje [R=301,L]
RewriteRule ^amazon/?$ /acoes/amazon-hoje [R=301,L]
RewriteRule ^microsoft/?$ /acoes/microsoft-hoje [R=301,L]
RewriteRule ^acoes/apple$ /acoes/apple-hoje [R=301,L]
RewriteRule ^acoes/amazon$ /acoes/amazon-hoje [R=301,L]

# Remover .html de URLs antigas
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)\.html$ /$1 [R=301,L]

# Remover index.html e index.php
RewriteRule ^(.*)index\.(html|php)$ /$1 [R=301,L]

# Se não for arquivo nem diretório, redireciona para index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
</IfModule>

# Headers de Cache para performance
<IfModule mod_headers.c>
  # Cache de imagens por 1 ano
  <FilesMatch "\.(jpg|jpeg|png|gif|ico|svg|webp)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>
  
  # Cache de CSS e JS por 1 mês
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>
  
  # Não fazer cache de HTML
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# Compressão GZIP para performance
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>
